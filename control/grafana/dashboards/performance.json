    {
      "type": "timeseries",
      "title": "Latência das mensagens MQTT (predição → agregador)",
      "id": 15,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Entre nós diferentes só é válida com relógios sincronizados (tools/sync_clocks.py).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 37
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le, mode) (rate(aidi_agg_message_delay_seconds_bucket[1m])))",
          "legendFormat": "p50 · {{mode}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, mode) (rate(aidi_agg_message_delay_seconds_bucket[1m])))",
          "legendFormat": "p95 · {{mode}}",
          "refId": "B"
        }
